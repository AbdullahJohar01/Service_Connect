# ServiceConnect environment variables
#
# Never commit real secrets or passwords.

# PostgreSQL production database password
SERVICE_CONNECT_DATABASE_PASSWORD=

# Optional PostgreSQL connection settings
# DATABASE_URL=
# MY_APP_DATABASE_URL=

# Rails server
PORT=3000

# Rails logging
RAILS_LOG_LEVEL=info

# Rails/Puma concurrency
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1

# Solid Queue
JOB_CONCURRENCY=1
SOLID_QUEUE_IN_PUMA=true

# Rails deployment secret
RAILS_MASTER_KEY=
