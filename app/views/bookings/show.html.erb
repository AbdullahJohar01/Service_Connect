<section class="booking-details-page">
  <div class="container">

    <div class="page-header">
      <p class="page-label">My Booking</p>

      <h1>
        <%= @booking.service_category.name %>
      </h1>

      <p>
        <%= @booking.provider.business_name %>
      </p>
    </div>

    <div class="booking-details">

      <p>
        <strong>Status:</strong>
        <%= @booking.status.humanize %>
      </p>

      <p>
        <strong>Date:</strong>
        <%= @booking.scheduled_at.strftime("%d %b %Y, %I:%M %p") %>
      </p>

      <p>
        <strong>Address:</strong>
        <%= [
          @booking.address.street,
          @booking.address.city,
          @booking.address.postal_code
        ].compact.join(", ") %>
      </p>

      <p>
        <strong>Description:</strong>
        <%= @booking.customer_description %>
      </p>

      <p>
        <strong>Estimated Price:</strong>
        <%= pkr(@booking.estimated_price) %>
      </p>

      <% if @booking.accepted? %>
        <%= button_to "Confirm Booking",
                      confirm_booking_path(@booking),
                      method: :patch,
                      class: "booking-submit-button" %>
      <% end %>

      <% unless @booking.completed? || @booking.cancelled? %>
        <%= button_to "Cancel Booking",
                      cancel_booking_path(@booking),
                      method: :patch,
                      class: "booking-cancel-button" %>
      <% end %>

      <%= link_to "Back to My Bookings",
                  bookings_path %>

    </div>

    <% if @booking.completed? %>

      <div class="booking-completed">

        <h2>Service Completed</h2>

        <p>
          Your service has been completed.
          We hope you had a great experience.
        </p>

        <% if @booking.review.present? %>

          <div class="review-submitted">

            <h3>Your Review</h3>

            <p>
              <strong>
                Rating:
                <%= "★" * @booking.review.rating %>
                <%= "☆" * (5 - @booking.review.rating) %>
              </strong>
            </p>

            <p>
              <%= @booking.review.comment %>
            </p>

          </div>

        <% else %>

          <div id="review" class="review-form-section">

            <h3>Leave a Review</h3>

            <p>
              Tell us about your experience with
              <strong><%= @booking.provider.business_name %></strong>.
            </p>

            <%= form_with model: @review,
                          url: review_booking_path(@booking),
                          method: :post,
                          local: true do |form| %>

              <div class="form-group">

                <%= form.label :rating, "Rating" %>

                <%= form.select :rating,
                                options_for_select(
                                  [
                                    [ "5 — Excellent", 5 ],
                                    [ "4 — Very Good", 4 ],
                                    [ "3 — Good", 3 ],
                                    [ "2 — Fair", 2 ],
                                    [ "1 — Poor", 1 ]
                                  ],
                                  @review.rating
                                ),
                                { prompt: "Select a rating" } %>

              </div>

              <div class="form-group">

                <%= form.label :comment, "Your Review" %>

                <%= form.text_area :comment,
                                   rows: 5,
                                   placeholder: "Share your experience..." %>

              </div>

              <%= form.submit "Submit Review",
                              class: "booking-submit-button" %>

            <% end %>

          </div>

        <% end %>

      </div>

    <% end %>

  </div>
</section>