<div class="home-page">
  <section class="home-hero">
    <div class="home-container">
      <div class="home-hero-content">
        <h1>Find trusted service professionals for your home.</h1>

        <p>
          Browse service categories, explore providers, and book the help you
          need through Service Connect.
        </p>

        <div class="home-hero-actions">
          <%= link_to "Find a Service",
                      "#services",
                      class: "home-primary-button" %>

          <%= link_to "Browse Providers",
                      providers_path,
                      class: "home-secondary-button" %>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section home-services" id="services">
    <div class="home-container">
      <div class="home-section-heading">
        <h2>Services</h2>

        <p>
          Choose a service category to find professionals who can help.
        </p>
      </div>

      <% if @service_categories.any? %>
        <div class="home-service-grid">
          <% @service_categories.each do |category| %>
            <% icon = case category.name.downcase
                      when "electrical" then "⚡"
                      when "plumbing" then "🔧"
                      when "cleaning" then "✦"
                      when "painting" then "🎨"
                      when "carpentry" then "⌂"
                      else "✓"
                      end %>

            <%= link_to providers_path(service_category_id: category.id),
                        class: "home-service-card" do %>
              <div class="home-service-icon">
                <%= icon %>
              </div>

              <div>
                <h3><%= category.name %></h3>

                <p>
                  <%= category.description.presence ||
                      "Find professionals for #{category.name.downcase} services." %>
                </p>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="home-empty-state">
          <h3>No services available yet</h3>

          <p>
            Service categories will appear here when they become available.
          </p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="home-section home-providers">
    <div class="home-container">
      <div class="home-section-heading home-section-heading-row">
        <div>
          <h2>Featured Providers</h2>

          <p>
            Explore service providers available through Service Connect.
          </p>
        </div>

        <%= link_to "View All Providers",
                    providers_path,
                    class: "home-text-link" %>
      </div>

      <% if @featured_providers.any? %>
        <div class="home-provider-grid">
          <% @featured_providers.each do |provider| %>
            <% service = provider.provider_services.find(&:active?) %>

            <%= link_to provider_path(provider),
                        class: "home-provider-card" do %>

              <div class="home-provider-avatar">
                <%= provider.business_name.to_s.first.upcase %>
              </div>

              <div class="home-provider-content">
                <h3><%= provider.business_name %></h3>

                <p>
                  <%= service&.service_category&.name || "Service Provider" %>
                </p>

                <div class="home-provider-meta">
                  <span>
                    <%= pluralize(
                          provider.experience_years,
                          "year"
                        ) %> experience
                  </span>

                  <strong>
                    PKR <%= number_with_delimiter(provider.hourly_rate) %>/hr
                  </strong>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="home-empty-state">
          <h3>No providers available yet</h3>

          <p>
            Approved service providers will appear here.
          </p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="home-section home-how-it-works">
    <div class="home-container">
      <div class="home-section-heading">
        <h2>How It Works</h2>

        <p>
          Finding and booking a service provider is simple.
        </p>
      </div>

      <div class="home-steps">
        <div class="home-step">
          <span>1</span>

          <div>
            <h3>Choose a Service</h3>

            <p>
              Select the service category that matches your needs.
            </p>
          </div>
        </div>

        <div class="home-step">
          <span>2</span>

          <div>
            <h3>Find a Provider</h3>

            <p>
              Browse providers and compare their experience and prices.
            </p>
          </div>
        </div>

        <div class="home-step">
          <span>3</span>

          <div>
            <h3>Book the Service</h3>

            <p>
              Choose a suitable time and submit your booking request.
            </p>
          </div>
        </div>

        <div class="home-step">
          <span>4</span>

          <div>
            <h3>Complete the Work</h3>

            <p>
              Follow the booking process until the service is completed.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
