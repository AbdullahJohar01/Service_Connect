            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings", ":id"]
            }
          }
        },
        {
          "name": "Accept Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/:id/accept",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings", ":id", "accept"]
            }
          }
        },
        {
          "name": "Reject Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/:id/reject",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings", ":id", "reject"]
            }
          }
        },
        {
          "name": "Confirm Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/:id/confirm",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings", ":id", "confirm"]
            }
          }
        },
        {
          "name": "Start Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/:id/start",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings", ":id", "start"]
            }
          }
        },
        {
          "name": "Complete Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/:id/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings", ":id", "complete"]
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookings/:id/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookings", ":id", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "GraphQL",
      "item": [
        {
          "name": "GraphQL Endpoint",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/graphql",
              "host": ["{{base_url}}"],
              "path": ["graphql"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { currentUser { id firstName lastName email role status } }\"\n}"
            }
          }
        }
      ]
    }
  ]
}
